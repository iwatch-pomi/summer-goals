# ===========================================================================
# summer-goals 環境変数テンプレート
# このファイルをコピーして `.env.local` を作り、値を埋めてください。
# （.env.local は .gitignore 済み。秘密鍵は絶対に GitHub に上げない）
#   cp .env.example .env.local
# 各値の取得方法は docs/SETUP.md を参照。
# ===========================================================================

# --- データベース（Supabase の Postgres 接続文字列）---
# Supabase ダッシュボード上部の「Connect」ボタン →「ORMs / Prisma」タブからコピー。
# DATABASE_URL = プール接続(6543)。実行時用。サーバーレスでの接続枯渇を防ぐ。
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL = 直接接続(5432)。prisma migrate 用。
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Supabase（認証 & 画像ストレージ）---
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
# サーバー側だけで使う。絶対にフロントへ出さない。
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# 進捗写真を保存するストレージのバケット名
SUPABASE_STORAGE_BUCKET="reports"

# --- Stripe（カード登録 & 決済）---
# Stripe ダッシュボード > Developers > API keys（最初はテストモード sk_test_ / pk_test_）
STRIPE_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
# Webhook 署名シークレット（Stripe CLI もしくはダッシュボードの Webhook 設定で取得）
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# --- デポジット返金モデルの金額（円。JPY はゼロ桁通貨 = 円そのまま）---
SYSTEM_FEE_YEN="500"          # 参加費（返金不可）
DEPOSIT_YEN="3000"            # デポジット（日割返金可・返金上限）
DAILY_FORFEIT_YEN="100"       # サボり1日あたりの失効額
CHALLENGE_DURATION_DAYS="30"  # チャレンジ日数
# チャレンジ開始日。本番(8月一斉スタート)は "2026-08-01" を設定。
# 未設定だと「参加した今日」から開始するので、テスト中でもすぐ報告できる。
CHALLENGE_START_DATE=""

# --- バッチ（Vercel Cron）保護用シークレット ---
# /api/cron/settlement を外部から叩かれないようにする共有シークレット
CRON_SECRET="set-a-long-random-string"
# 返金バッチの1回あたり処理件数（Vercel Hobby の60秒上限対策。既定 40）。
# Pro プランで一気に処理したい場合は大きくしてよい。
SETTLEMENT_PAGE_SIZE="40"

# --- アプリ設定 ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_TIMEZONE="Asia/Tokyo"
