# ===========================================================================
# summer-goals 環境変数テンプレート
# このファイルをコピーして `.env.local` を作り、値を埋めてください。
# （.env.local は .gitignore 済み。秘密鍵は絶対に GitHub に上げない）
#   cp .env.example .env.local
# 各値の取得方法は docs/SETUP.md を参照。
# ===========================================================================

# --- データベース（Supabase の Postgres 接続文字列）---
# Supabase > Project Settings > Database > Connection string (URI)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# --- Supabase（認証 & 画像ストレージ）---
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
# サーバー側だけで使う。絶対にフロントへ出さない。
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# 進捗写真を保存するストレージのバケット名
SUPABASE_STORAGE_BUCKET="reports"

# --- Stripe（カード登録 & 決済）---
# Stripe ダッシュボード > Developers > API keys（最初はテストモード sk_test_ / pk_test_）
STRIPE_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
# Webhook 署名シークレット（Stripe CLI もしくはダッシュボードの Webhook 設定で取得）
STRIPE_WEBHOOK_SECRET="whsec_xxx"
# ペナルティ金額（円）。MVP は 500 円。
PENALTY_AMOUNT_JPY="500"

# --- 日次バッチ（Vercel Cron）保護用シークレット ---
# /api/cron/daily-penalty を外部から叩かれないようにする共有シークレット
CRON_SECRET="set-a-long-random-string"

# --- ギフト発行（eGift）---
# MVP では未契約でも動くよう "manual"（手動発行キュー）を既定にしている。
# giftee 等の API を契約したら "giftee" に変更し、キーを設定する。
GIFT_PROVIDER="manual"
GIFT_API_KEY=""

# --- アプリ設定 ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_TIMEZONE="Asia/Tokyo"
