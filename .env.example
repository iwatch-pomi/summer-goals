# ===========================================================================
# ススメ（参考書ランキング）環境変数テンプレート
# このファイルをコピーして `.env.local` を作り、値を埋めてください。
# （.env.local は .gitignore 済み。秘密鍵は絶対に GitHub に上げない）
#   cp .env.example .env.local
# 各値の取得方法は docs/SETUP.md を参照。
# ===========================================================================

# --- データベース（Supabase の Postgres 接続文字列）---
# Supabase ダッシュボード上部の「Connect」ボタン →「ORMs / Prisma」タブからコピー。
# DATABASE_URL = プール接続(6543)。実行時用。サーバーレスでの接続枯渇を防ぐ。
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL = 直接接続(5432)。prisma migrate 用。
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Supabase（認証 & 画像ストレージ）---
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
# サーバー側だけで使う。絶対にフロントへ出さない。
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# 進捗写真を保存するストレージのバケット名
SUPABASE_STORAGE_BUCKET="reports"

# --- バッチ（Vercel Cron）保護用シークレット ---
# /api/cron/purge-accounts を外部から叩かれないようにする共有シークレット
CRON_SECRET="set-a-long-random-string"

# --- アプリ設定 ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_TIMEZONE="Asia/Tokyo"
