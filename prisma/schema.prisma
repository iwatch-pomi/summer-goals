// ===========================================================================
// summer-goals — Prisma スキーマ
// 「公開宣言（宣言効果）」型の目標達成サービスのデータモデル。
// 目標＝公開宣言 / 日々の報告＝公開の進捗 / 応援（エール）＝ワンタップ支援。
// 決済（デポジット・返金）は撤去済み。
// ===========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---- enum ----------------------------------------------------------------

enum GoalGenre {
  ENGLISH // 英語学習
  MUSCLE_TRAINING // 筋トレ
  STUDY // 勉強・資格
  READING // 読書
  DIET // ダイエット
  OTHER // その他
}

enum GoalStatus {
  MATCHING // （旧・未使用。互換のため残置）
  ACTIVE // 進行中
  COMPLETED // 期間満了
  CANCELLED // 取消・退会
}

/// 日々の報告方法（目標登録時に選ぶ）。
enum ReportMethod {
  PHOTO // 写真を提出して報告
  BUTTON // 「勉強した」ボタンを押すだけ
  TIMER // アプリ内タイマーで規定時間の勉強が必要
}

// ---- モデル ---------------------------------------------------------------

/// アプリ利用者。Supabase Auth のユーザーと email で 1:1 に対応する。
model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  displayName         String    @unique // 公開ユーザーネーム（共有プロフィールのURLにも使う）
  university          String? // 大学名（任意・公開）
  profileComplete     Boolean   @default(false) // ユーザーネーム設定済みか（Google初回は false→onboarding）
  avatarSeed          String // アバター生成用シード
  timezone            String    @default("Asia/Tokyo")
  status              String    @default("ACTIVE") // ACTIVE / PENDING_DELETION
  deletionScheduledAt DateTime? // 退会申請時に now+7日。この時刻を過ぎたら完全削除
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  goals           Goal[]
  reports         Report[]
  roomsCreated    Room[]       @relation("RoomCreator")
  roomMemberships RoomMember[]
  cheers          Cheer[]
}

/// ユーザーが設定する目標＝公開宣言。
model Goal {
  id            String       @id @default(uuid())
  userId        String
  genre         GoalGenre? // 任意タグ
  title         String
  description   String?
  reportMethod  ReportMethod @default(PHOTO) // 日々の報告方法（写真／ボタン／タイマー）
  studyMinutes  Int? // TIMER方式のときの規定勉強分数
  isPublic      Boolean      @default(true) // 公開宣言（既定で公開）
  dailyDeadline String       @default("23:59") // 締切時刻(JST)
  periodStart   DateTime     @db.Date
  periodEnd     DateTime     @db.Date
  status        GoalStatus   @default(ACTIVE)
  createdAt     DateTime     @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports Report[]
  cheers  Cheer[]

  @@index([userId])
  @@index([isPublic, createdAt]) // 公開タイムライン抽出用
}

/// 毎日の進捗報告（テキスト + 写真）。目標（宣言）に紐づく公開の進捗。
/// 報告有無のフラグ = 当該日に行が存在するか。
model Report {
  id             String   @id @default(uuid())
  userId         String
  goalId         String // 報告は目標（宣言）に紐づく
  reportDate     DateTime @db.Date // 対象日(JST)
  textContent    String // メモ（方式により任意。未入力は空文字）
  photoUrl       String? // 非公開バケット上のパス（表示時に署名URLを発行）
  studiedSeconds Int? // TIMER方式で集中した秒数（表示に使用）
  createdAt      DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id])
  goal   Goal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  cheers Cheer[]

  @@unique([goalId, reportDate]) // 1目標1日1報告・冪等性の核
  @@index([userId, reportDate])
  @@index([createdAt]) // 公開タイムライン抽出用
}

/// 応援（エール）。宣言（Goal）または進捗（Report）へのワンタップ支援。
/// goalId / reportId はどちらか一方のみを持つ（API で強制）。
model Cheer {
  id        String   @id @default(uuid())
  userId    String // 応援した人
  goalId    String? // 宣言への応援
  reportId  String? // 進捗への応援
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal   Goal?   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  report Report? @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([userId, goalId]) // 同一宣言に二重応援不可（NULL は複数可）
  @@unique([userId, reportId]) // 同一報告に二重応援不可
  @@index([goalId])
  @@index([reportId])
}

/// 一緒に取り組む「部屋」。報告ボード（メンバーの当日報告を見せ合う）用。
model Room {
  id          String     @id @default(uuid())
  name        String
  description String?
  genre       GoalGenre? // 任意のジャンルタグ
  createdById String
  maxMembers  Int        @default(20)
  createdAt   DateTime   @default(now())

  createdBy User         @relation("RoomCreator", fields: [createdById], references: [id])
  members   RoomMember[]

  @@index([createdAt])
}

/// 部屋への参加（1人が複数部屋に参加可）。
model RoomMember {
  id       String   @id @default(uuid())
  roomId   String
  userId   String
  joinedAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId]) // 二重入室防止
  @@index([userId])
  @@index([roomId])
}
