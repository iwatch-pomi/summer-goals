// ===========================================================================
// 参考書ランキング — Prisma スキーマ
// 「参考書・教科書の進捗を報告して競い合う」学習サービスのデータモデル。
// 参考書（取り組み）＝Goal / 日々の進捗（ページ数）＝Report /
// 応援（エール）＝ワンタップ支援。決済・勉強部屋は撤去済み。
// ===========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---- enum ----------------------------------------------------------------

/// 科目タグ（受験・資格向け）。参考書・ランキングの絞り込みに使う。
enum GoalGenre {
  ENGLISH // 英語
  MATH // 数学
  JAPANESE // 国語
  SCIENCE // 理科
  SOCIAL // 社会
  TOEIC // TOEIC
  QUALIFICATION // 資格
  MAJOR // 専門科目
  OTHER // その他
}

enum GoalStatus {
  MATCHING // （旧・未使用。互換のため残置）
  ACTIVE // 進行中
  COMPLETED // 期間満了
  CANCELLED // 取消・退会
}

/// 日々の報告方法（目標登録時に選ぶ）。
enum ReportMethod {
  PHOTO // 写真を提出して報告
  BUTTON // 「勉強した」ボタンを押すだけ
  TIMER // アプリ内タイマーで規定時間の勉強が必要
}

// ---- モデル ---------------------------------------------------------------

/// アプリ利用者。Supabase Auth のユーザーと email で 1:1 に対応する。
model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  displayName         String    @unique // 公開ユーザーネーム（共有プロフィールのURLにも使う）
  university          String? // 大学名（任意・公開）
  profileComplete     Boolean   @default(false) // ユーザーネーム設定済みか（Google初回は false→onboarding）
  avatarSeed          String // アバター生成用シード
  timezone            String    @default("Asia/Tokyo")
  status              String    @default("ACTIVE") // ACTIVE / PENDING_DELETION
  deletionScheduledAt DateTime? // 退会申請時に now+7日。この時刻を過ぎたら完全削除
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  goals   Goal[]
  reports Report[]
  cheers  Cheer[]
}

/// ユーザーが取り組む参考書・教科書（title＝参考書名）。公開の取り組み。
model Goal {
  id            String       @id @default(uuid())
  userId        String
  genre         GoalGenre? // 科目タグ（任意）
  title         String
  description   String?
  totalPages    Int? // 参考書の総ページ数（任意・進捗バー用）
  reportMethod  ReportMethod @default(PHOTO) // 日々の報告方法（写真／ボタン／タイマー）
  studyMinutes  Int? // TIMER方式のときの規定勉強分数
  isPublic      Boolean      @default(true) // 公開（既定で公開）
  dailyDeadline String       @default("23:59") // 締切時刻(JST)
  periodStart   DateTime     @db.Date
  periodEnd     DateTime     @db.Date
  status        GoalStatus   @default(ACTIVE)
  createdAt     DateTime     @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports Report[]
  cheers  Cheer[]

  @@index([userId])
  @@index([isPublic, createdAt]) // 公開タイムライン抽出用
}

/// 毎日の進捗報告（テキスト + 写真）。目標（宣言）に紐づく公開の進捗。
/// 報告有無のフラグ = 当該日に行が存在するか。
model Report {
  id             String   @id @default(uuid())
  userId         String
  goalId         String // 報告は目標（宣言）に紐づく
  reportDate     DateTime @db.Date // 対象日(JST)
  textContent    String // メモ（方式により任意。未入力は空文字）
  pagesRead      Int? // その日進めたページ数（ランキングの基礎）
  photoUrl       String? // 非公開バケット上のパス（表示時に署名URLを発行）
  studiedSeconds Int? // TIMER方式で集中した秒数（表示に使用）
  createdAt      DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id])
  goal   Goal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  cheers Cheer[]

  @@unique([goalId, reportDate]) // 1目標1日1報告・冪等性の核
  @@index([userId, reportDate])
  @@index([createdAt]) // 公開タイムライン抽出用
}

/// 応援（エール）。宣言（Goal）または進捗（Report）へのワンタップ支援。
/// goalId / reportId はどちらか一方のみを持つ（API で強制）。
model Cheer {
  id        String   @id @default(uuid())
  userId    String // 応援した人
  goalId    String? // 宣言への応援
  reportId  String? // 進捗への応援
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal   Goal?   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  report Report? @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([userId, goalId]) // 同一取り組みに二重応援不可（NULL は複数可）
  @@unique([userId, reportId]) // 同一報告に二重応援不可
  @@index([goalId])
  @@index([reportId])
}
